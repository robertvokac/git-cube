[Unit]
Description=GitCube local Git mirror server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/gitcube --data-dir %h/.local/share/gitcube --port 9999 --workers 2
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.local/share/gitcube
MemoryHigh=2G
MemoryMax=4G
MemorySwapMax=1G
TasksMax=128
LimitNOFILE=4096
OOMPolicy=stop

[Install]
WantedBy=default.target
