[Unit]
Description=GitCube local Git mirror server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gitcube --data-dir %h/.local/share/gitcube --port 9999 --workers 2
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/gitcube

[Install]
WantedBy=default.target
